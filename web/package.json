{
  "name": "ri-layercake-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "py": "node scripts/fetch-py.mjs",
    "dev": "next dev",
    "build": "next build && node scripts/csp.mjs",
